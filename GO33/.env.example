PIANOVA_SECRET_KEY=replace-with-a-long-random-secret
PIANOVA_ADMIN_USERNAME=admin
PIANOVA_ADMIN_PASSWORD=replace-with-a-strong-admin-password

PIANOVA_SMTP_HOST=smtp.gmail.com
PIANOVA_SMTP_PORT=465
PIANOVA_SMTP_USER=your-email@example.com
PIANOVA_SMTP_PASSWORD=your-app-password
PIANOVA_SMTP_FROM=your-email@example.com
PIANOVA_SMTP_USE_TLS=0
PIANOVA_ALLOW_LOCAL_OTP_FALLBACK=0

PIANOVA_RESEND_API_KEY=
PIANOVA_RESEND_FROM=

PIANOVA_AUTH_ALLOWED_ORIGINS=https://yourdomain.com
PIANOVA_ALLOW_NULL_ORIGIN=0
PIANOVA_SECURE_COOKIES=1
FLASK_DEBUG=0

PIANOVA_PASSWORD_MIN_LENGTH=8
PIANOVA_AUTH_CODE_TTL_SECONDS=300
PIANOVA_AUTH_CODE_RESEND_SECONDS=30
PIANOVA_AUTH_CODE_MAX_ATTEMPTS=5
PIANOVA_AUTH_VERIFIED_SESSION_TTL_SECONDS=300
