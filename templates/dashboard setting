<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pianova Settings</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      min-height: 100vh;
      background: #030303;
      color: #f5f0e8;
      font-family: Inter, sans-serif;
    }

    .app {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 230px 1fr;
      background:
        radial-gradient(circle at 85% 10%, rgba(212, 161, 58, .08), transparent 24%),
        linear-gradient(90deg, #050505, #020202);
    }

    .sidebar {
      border-right: 1px solid rgba(255,255,255,.12);
      background: rgba(4,4,4,.96);
      padding: 26px 19px 0;
      display: flex;
      flex-direction: column;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 13px;
      margin-bottom: 42px;
      color: #f4c75f;
    }

    .clef {
      font-family: "Playfair Display", serif;
      font-size: 58px;
      line-height: .8;
      text-shadow: 0 0 18px rgba(244,199,95,.28);
    }

    .logo h1 {
      font-family: "Playfair Display", serif;
      font-size: 23px;
      letter-spacing: 1px;
      color: #f5d26f;
    }

    .logo p {
      margin-top: 5px;
      font-size: 12px;
      color: #bca878;
    }

    .nav {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .nav a, .logout {
      height: 46px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 0 16px;
      color: #ddd9d1;
      text-decoration: none;
      font-size: 15px;
      border: 1px solid transparent;
    }

    .nav a.active {
      color: #f9d36a;
      background: linear-gradient(90deg, rgba(245,194,77,.26), rgba(245,194,77,.08));
      border-color: rgba(245,194,77,.45);
      box-shadow: inset 4px 0 0 #f3bd4f;
    }

    .icon {
      width: 23px;
      text-align: center;
      font-size: 19px;
      color: currentColor;
    }

    .premium {
      margin: 22px 2px;
      padding: 19px 18px;
      border-radius: 14px;
      border: 1px solid rgba(245,194,77,.22);
      text-align: center;
      background: rgba(10,10,10,.8);
    }

    .premium .crown {
      color: #f5c64d;
      font-size: 30px;
      margin-bottom: 8px;
    }

    .premium h3 {
      color: #f4c75f;
      font-size: 16px;
      margin-bottom: 8px;
    }

    .premium p {
      color: #d2c7b5;
      font-size: 12px;
      line-height: 1.45;
      margin-bottom: 14px;
    }

    button {
      font-family: inherit;
      cursor: pointer;
    }

    .gold-btn {
      border: 0;
      border-radius: 8px;
      padding: 11px 23px;
      color: #130d03;
      font-weight: 800;
      background: linear-gradient(135deg, #ffe798, #f3b93f 62%, #b97719);
      box-shadow: 0 8px 20px rgba(243,185,63,.18);
    }

    .logout {
      margin: auto -19px 0;
      border-radius: 0;
      border-top: 1px solid rgba(255,255,255,.12);
      padding-left: 34px;
      height: 76px;
      background: transparent;
    }

    main {
      padding: 38px 36px 44px;
    }

    .top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 28px;
    }

    .title h2 {
      font-size: 28px;
      margin-bottom: 8px;
    }

    .title p { color: #c8c0b6; }

    .userbar {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .bell {
      width: 46px;
      height: 46px;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,.12);
      background: #050505;
      color: #f2f2f2;
      font-size: 20px;
    }

    .avatar {
      width: 46px;
      height: 46px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: rgba(245,194,77,.14);
      border: 1px solid rgba(245,194,77,.5);
      color: #f5c64d;
      font-weight: 800;
      font-size: 21px;
    }

    .username {
      font-weight: 700;
      color: #f4f0e8;
    }

    .content {
      display: grid;
      grid-template-columns: 225px 1fr;
      gap: 18px;
      max-width: 966px;
    }

    .settings-menu {
      min-height: 682px;
      border-radius: 12px;
      border: 1px solid rgba(245,194,77,.18);
      background: rgba(6,6,6,.86);
      padding: 10px 0;
      overflow: hidden;
    }

    .tab {
      height: 56px;
      display: flex;
      align-items: center;
      gap: 18px;
      padding: 0 27px;
      color: #d8d3ca;
      font-size: 15px;
      border-left: 4px solid transparent;
    }

    .tab.active {
      color: #f7cc62;
      background: linear-gradient(90deg, rgba(245,194,77,.27), rgba(245,194,77,.08));
      border-left-color: #f3bd4f;
    }

    .panel {
      border-radius: 11px;
      border: 1px solid rgba(245,194,77,.18);
      background: rgba(10,10,10,.85);
    }

    .profile-card {
      min-height: 373px;
      padding: 31px 36px 26px;
      position: relative;
      margin-bottom: 12px;
    }

    .section-title {
      color: #f4c75f;
      font-size: 18px;
      margin-bottom: 8px;
    }

    .section-sub {
      color: #cfc7bd;
      font-size: 14px;
      margin-bottom: 48px;
    }

    .profile-avatar {
      position: absolute;
      top: 27px;
      right: 157px;
      width: 86px;
      height: 86px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      border: 1px solid rgba(245,194,77,.8);
      color: #f5c64d;
      font-size: 42px;
      font-weight: 800;
      background: rgba(245,194,77,.1);
    }

    .edit {
      position: absolute;
      right: -3px;
      bottom: -1px;
      width: 31px;
      height: 31px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      border: 1px solid rgba(245,194,77,.8);
      background: #111;
      font-size: 14px;
    }

    label {
      display: block;
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 8px;
      color: #f2eee7;
    }

    input {
      width: 100%;
      height: 42px;
      border-radius: 7px;
      border: 1px solid rgba(255,255,255,.08);
      background: #151515;
      color: #f4f0e8;
      padding: 0 15px;
      font-size: 14px;
      outline: none;
      margin-bottom: 26px;
    }

    input:focus {
      border-color: rgba(245,194,77,.65);
      box-shadow: 0 0 0 3px rgba(245,194,77,.08);
    }

    .save {
      width: 142px;
      height: 39px;
      border-radius: 7px;
      font-size: 13px;
    }

    .row-card {
      height: 91px;
      padding: 0 34px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 12px;
    }

    .row-left {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .row-icon {
      width: 36px;
      color: #f5c64d;
      font-size: 30px;
      text-align: center;
    }

    .row-card h3 {
      color: #f4c75f;
      font-size: 16px;
      margin-bottom: 6px;
    }

    .row-card p {
      color: #cfc7bd;
      font-size: 13px;
    }

    .arrow {
      color: #f5c64d;
      font-size: 31px;
    }

    .danger h3, .danger .row-icon { color: #ff6571; }

    .delete-btn {
      width: 144px;
      height: 44px;
      border-radius: 7px;
      border: 1px solid #c9414e;
      background: transparent;
      color: #ff6571;
      font-weight: 800;
    }

    @media (max-width: 900px) {
      .app { grid-template-columns: 1fr; }
      .sidebar { display: none; }
      .content { grid-template-columns: 1fr; }
      .settings-menu { min-height: auto; }
      .profile-avatar { position: relative; top: auto; right: auto; margin-bottom: 24px; }
      .top { flex-direction: column; gap: 20px; }
    }
  </style>
</head>
<body>
  <div class="app">
    <aside class="sidebar">
      <div class="logo">
        <div class="clef">𝄞</div>
        <div>
          <h1>PIANOVA</h1>
          <p>Play. Learn. Grow.</p>
        </div>
      </div>

      <nav class="nav">
        <a href="#"><span class="icon">⌂</span>Dashboard</a>
        <a href="#"><span class="icon">▰</span>Lessons</a>
        <a href="#"><span class="icon">♪</span>Practice</a>
        <a href="#"><span class="icon">♬</span>Note Game</a>
        <a href="#"><span class="icon">▣</span>Scores</a>
        <a href="#"><span class="icon">▮</span>Progress</a>
        <a href="#"><span class="icon">♕</span>Achievements</a>
        <a href="#"><span class="icon">♟</span>Leaderboard</a>
        <a class="active" href="#"><span class="icon">⚙</span>Settings</a>
      </nav>

      <div class="premium">
        <div class="crown">♛</div>
        <h3>Go Premium</h3>
        <p>Unlock all lessons,<br>games and features.</p>
        <button class="gold-btn">Upgrade Now</button>
      </div>

      <a class="logout" href="#"><span class="icon">↪</span>Logout</a>
    </aside>

    <main>
      <header class="top">
        <div class="title">
          <h2>Settings</h2>
          <p>Manage your account and preferences</p>
        </div>

        <div class="userbar">
          <button class="bell">♧</button>
          <div class="avatar">S</div>
          <div class="username">Shastikaa</div>
          <div>⌄</div>
        </div>
      </header>

      <section class="content">
        <aside class="settings-menu">
          <div class="tab active"><span class="icon">♙</span>Profile</div>
          <div class="tab"><span class="icon">☻</span>Account</div>
          <div class="tab"><span class="icon">☷</span>Preferences</div>
          <div class="tab"><span class="icon">♢</span>Security</div>
        </aside>

        <div>
          <section class="panel profile-card">
            <h3 class="section-title">Profile</h3>
            <p class="section-sub">Manage your personal information</p>

            <div class="profile-avatar">
              S
              <div class="edit">♢</div>
            </div>

            <label>Full Name</label>
            <input value="Shastikaa" />

            <label>Email Address</label>
            <input value="shastikaa@gmail.com" />

            <button class="gold-btn save">Save Changes</button>
          </section>

          <section class="panel row-card">
            <div class="row-left">
              <div class="row-icon">☷</div>
              <div>
                <h3>Preferences</h3>
                <p>Customize your learning experience</p>
              </div>
            </div>
            <div class="arrow">›</div>
          </section>

          <section class="panel row-card">
            <div class="row-left">
              <div class="row-icon">♢</div>
              <div>
                <h3>Security</h3>
                <p>Change password and manage security</p>
              </div>
            </div>
            <div class="arrow">›</div>
          </section>

          <section class="panel row-card danger">
            <div class="row-left">
              <div class="row-icon">▥</div>
              <div>
                <h3>Danger Zone</h3>
                <p>Delete your account and all data</p>
              </div>
            </div>
            <button class="delete-btn">Delete Account</button>
          </section>
        </div>
      </section>
    </main>
  </div>
</body>
</html>